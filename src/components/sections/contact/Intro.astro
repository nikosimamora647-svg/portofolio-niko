---
// components
import Heading from "../../elements/Heading.astro";
import Container from "../../elements/Container.astro";
import Text from "../../elements/Text.astro";
---

<Container variant={'xl'} class="text-center text-base-900 flex flex-col items-center">
    <Heading tagName="h1" tagSize="h1">Contact</Heading>
    <div class="max-w-3xl flex flex-col gap-4">
        <Text variant={'xl'}>Mari Kita Belajar Bersama!</Text>
        <Text variant={'sm'}>Punya semangat untuk belajar dan mencoba hal baru? Mari berbagi ide, menambah pengetahuan, dan mengembangkan kemampuan bersama.</Text>
        <Text variant={'sm'}>Saya terbuka untuk berdiskusi, belajar, dan bertukar pengalaman. Jangan ragu untuk menghubungi saya!</Text>
    </div>
</Container>