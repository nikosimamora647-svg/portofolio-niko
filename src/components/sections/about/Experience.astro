---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const experience = [
    { 
        title: "UI/UX Designer",
        place: "FIGMA DESIGN",
        period: "2023 – 2024",
        text: "Mempelajari dan merancang tampilan antarmuka website serta aplikasi menggunakan Figma. Berfokus pada desain yang menarik, sederhana, dan mudah digunakan oleh pengguna."
    },
    { 
        title: "Web Developer",
        place: "WEB DEVELOPMENT",
        period: "2024 – 2025",
        text: "Membangun dan mengembangkan berbagai website menggunakan HTML, CSS, JavaScript, PHP, serta MySQL. Berusaha menciptakan website yang responsif, fungsional, dan nyaman digunakan."
    },
    { 
        title: "Brand & Visual Designer",
        place: "CREATIVE DESIGN",
        period: "2025",
        text: "Mengembangkan kreativitas dalam membuat desain visual, memilih warna, mengatur tipografi, serta menciptakan tampilan yang memiliki identitas dan karakter tersendiri."
    },
    { 
        title: "Junior Designer",
        place: "PERSONAL DEVELOPMENT",
        period: "2026 – Sekarang",
        text: "Terus mengembangkan kemampuan di bidang desain UI/UX, pengembangan website, dan teknologi. Aktif mempelajari hal-hal baru serta mengerjakan berbagai proyek untuk menambah pengalaman dan meningkatkan keterampilan."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Experience</Heading>
    <div class="flex flex-col gap-4">  
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                experience.map((i) => (
                    <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
                ))
            }
        </Container>
        <ContainerBottom />
    </div>

</Container>
