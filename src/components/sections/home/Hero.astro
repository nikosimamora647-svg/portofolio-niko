---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import peter from "../../../assets/images/peter.jpg";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen">
    <p class="anim-slide-left anim-fade-up-d1 text-base-900 lg:max-w-[33%] md:max-w-[50%] w-full font-mono text-xl leading-relaxed">
        Hei! Saya berspesialisasi dalam membuat desain yang unik dan menarik yang membantu bisnis Anda tampil menonjol di pasar yang penuh persaingan.
    </p>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4">
            <div class="anim-fade-up anim-fade-up-d2">
                <Link variant={'button'} href="/contact">Tersedia untuk Proyek</Link>
            </div>
            <div class="anim-fade-up anim-fade-up-d3 anim-glitch">
                <Heading tagName="h1" tagSize="h1">Thomas Niko Aprijan Simamora</Heading>
            </div>
        </Container>
        <div class="anim-fade-in anim-fade-up-d4 h-full md:h-[500px] flex-1">
            <ImageContainer src={peter} alt="Thomas Niko Aprijan Simamora" />
        </div>
    </Container>
</Container>

<script>
    // Intersection Observer for scroll-triggered animations
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.15 });

    document.querySelectorAll('.reveal, .reveal-left').forEach(el => observer.observe(el));
</script>

